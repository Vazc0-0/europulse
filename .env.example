# Copy to .env and fill in. .env is ignored by Git: never commit real secrets.

# Where bronze files and the DuckDB warehouse live (default: ./data)
# EUROPULSE_DATA_DIR=./data

# --- Alerts (optional) -------------------------------------------------------
# Slack incoming webhook used by the Airflow failure / freshness alerts
# EUROPULSE_SLACK_WEBHOOK_URL=

# --- AI layer (optional) -----------------------------------------------------
# Provider: azure_openai | openai | anthropic
# EUROPULSE_LLM_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Airflow (docker compose) -----------------------------------------------
# AIRFLOW_UID=50000
